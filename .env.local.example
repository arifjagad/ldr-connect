# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Midtrans ───────────────────────────────────────────────
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Set ke "true" untuk production (Snap API prod vs sandbox)
MIDTRANS_IS_PRODUCTION=false

# ─── AI (opsional) ──────────────────────────────────────────
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ─── Daily.co (video call) ──────────────────────────────────
DAILY_API_KEY=
NEXT_PUBLIC_DAILY_DOMAIN=

# ─── Web Push (VAPID) ───────────────────────────────────────
# Generate dengan: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:youremail@example.com

# ─── Cron Secret ────────────────────────────────────────────
# Buat string acak panjang, tambahkan juga di Vercel Environment Variables
CRON_SECRET=your-secret-random-string-here
