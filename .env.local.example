MIDTRANS_IS_PRODUCTION=false

# ─── AI (opsional) ──────────────────────────────────────────
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ─── Daily.co (video call) ──────────────────────────────────
DAILY_API_KEY=
NEXT_PUBLIC_DAILY_DOMAIN=
